coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Logs
logs/
*.log

# Environment files: commit only the schema, which documents variables and safe defaults
.env
.env.*
*.env
!.env.schema

# Code-signing material for packaged builds
*.p12
*.pfx
*.pem
*.key
*.provisionprofile

# OS and editor files
.DS_Store
Thumbs.db
.idea/

# Agent files that belong on one machine only (agentics)
.claude/memory/
.claude/settings.local.json
.claude/worktrees/
