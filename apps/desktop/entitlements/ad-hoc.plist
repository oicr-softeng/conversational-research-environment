<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- V8 needs to map executable memory under the hardened runtime -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- An ad-hoc signature has no Team ID, so library validation would refuse Electron's framework. Never in a Developer ID build -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
