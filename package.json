		"eslint-import-resolver-typescript": "^3.7.0",
		"eslint-plugin-file-extension-in-import-ts": "^2.1.1",
		"eslint-plugin-import": "^2.31.0",
		"globals": "^15.14.0",
		"prettier": "3.8.3",
		"tsx": "^4.19.2",
		"typescript": "^5.8.2",
		"typescript-eslint": "^8.26.1",
		"wireit": "^0.14.13"
	}
